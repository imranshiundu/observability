    {
      "id": 1,
      "type": "bargauge",
      "title": "Failed logins \u2014 by reason",
      "description": "Incorrect passwords vs. unknown accounts vs. 2FA; spikes here mean abuse.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (increase(ils_auth_login_failed_total[$__range]))",
          "instant": true,
          "legendFormat": "{{reason}}"
        }
      ]
    },
